{
  "ci": {
    "collect": {
      "startServerCommand": "npm run start -- -p 3000",
      "startServerReadyPattern": "Ready",
      "startServerReadyTimeout": 60000,
      "url": [
        "http://localhost:3000/",
        "http://localhost:3000/blog/ccna-journey",
        "http://localhost:3000/gallery",
        "http://localhost:3000/docs/labs"
      ],
      "numberOfRuns": 3,
      "settings": {
        "onlyCategories": ["performance"],
        "chromeFlags": "--no-sandbox --headless=new"
      }
    },
    "assert": {
      "assertions": {
        "cumulative-layout-shift": ["error", { "maxNumericValue": 0.1, "aggregationMethod": "median-run" }],
        "total-blocking-time": ["error", { "maxNumericValue": 200, "aggregationMethod": "median-run" }],
        "largest-contentful-paint": [
          "error",
          { "maxNumericValue": 5000, "aggregationMethod": "median-run" }
        ],
        "total-byte-weight": ["error", { "maxNumericValue": 1000000, "aggregationMethod": "median-run" }],
        "categories:performance": ["warn", { "minScore": 0.85, "aggregationMethod": "median-run" }]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci"
    }
  }
}
