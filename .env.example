# Canonical origin for absolute URLs (canonicals, sitemap, RSS, OG images).
# Set in production; local dev falls back to http://localhost:3000 and
# Vercel deployments fall back to the Vercel production URL.
# See src/lib/shared.ts.
NEXT_PUBLIC_SITE_URL=https://rajkumarneupane.com

# Resume PDF for POST /api/resume (server-only; never NEXT_PUBLIC_).
# The PDF is not in the repo. Point this at a private file, e.g. the GitHub
# contents API URL of a file in a private repo, with a fine-grained token
# that can only read that repo. In `next dev` without these, the route reads
# private/Rajkumar_Neupane_Resume.pdf.
RESUME_PDF_URL=https://api.github.com/repos/raiz-toff/private-assets/contents/Rajkumar_Neupane_Resume.pdf
RESUME_PDF_TOKEN=

# Comments on blog posts and labs (fuma-comment + GitHub Discussions).
# The widget is hidden until CLIENT_ID and CATEGORY_ID are set.
# GitHub App (recommended) or OAuth App; callback URL:
#   https://rajkumarneupane.com/api/comments/oauth/callback
COMMENTS_GITHUB_CLIENT_ID=
COMMENTS_GITHUB_CLIENT_SECRET=
# Random string, 32+ chars; encrypts the reader's token cookie.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
COMMENTS_TOKEN_SECRET=
# Node id (DIC_...) of the "Comments" Discussions category in raiz-toff/loopback0:
#   gh api graphql -f query='{ repository(owner:"raiz-toff", name:"loopback0"){ discussionCategories(first:25){nodes{ id name }} } }'
COMMENTS_GITHUB_CATEGORY_ID=
# Server token for signed-out reads and opening each page's thread.
# Fine-grained PAT: only raiz-toff/loopback0, Discussions read and write.
COMMENTS_GITHUB_READ_TOKEN=
