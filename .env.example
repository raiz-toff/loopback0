# Canonical origin for absolute URLs (canonicals, sitemap, RSS, OG images).
# Set in production; local dev falls back to http://localhost:3000 and
# Vercel deployments fall back to the Vercel production URL.
# See src/lib/shared.ts.
NEXT_PUBLIC_SITE_URL=https://rajkumarneupane.com

# Resume PDF for POST /api/resume (server-only; never NEXT_PUBLIC_).
# The PDF is not in the repo. Point this at a private file, e.g. the GitHub
# contents API URL of a file in a private repo, with a fine-grained token
# that can only read that repo. In `next dev` without these, the route reads
# private/Rajkumar_Neupane_Resume.pdf.
RESUME_PDF_URL=https://api.github.com/repos/raiz-toff/private-assets/contents/Rajkumar_Neupane_Resume.pdf
RESUME_PDF_TOKEN=
